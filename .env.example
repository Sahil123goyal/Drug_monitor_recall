# Local development only. Copy to .env; never commit real secrets.
POSTGRES_USER=drug_monitor
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=drug_monitor
POSTGRES_PORT=5432

# Keep credentials/port in sync with POSTGRES_* above. URL-encode passwords.
# Use host "postgres" instead of "localhost" from another Compose service.
DATABASE_URL=postgresql+psycopg://drug_monitor:local_dev_change_me@localhost:5432/drug_monitor

OPENFDA_BASE_URL=https://api.fda.gov/drug/enforcement.json
OPENFDA_API_KEY="iily5nQdkkpEKP3Age6WbJssUwkzV7odaajE367n"
OPENFDA_TIMEOUT_SECONDS=15
OPENFDA_MAX_RETRIES=3
OPENFDA_PAGE_SIZE=100
GROQ_API_KEY=your_groq_api_key_here
# Set a model available to your Groq account that supports JSON object mode.
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_RETRIES=2
GROQ_MIN_CONFIDENCE=0.90
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=drug-recall-monitor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Streamlit connects to the API; provider credentials are not entered in the UI.
DRUG_MONITOR_API_URL=http://127.0.0.1:8000


# Daily medicine checks (local time); mock alerts still require human approval.
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DESTINATION=mock://synthetic-household
